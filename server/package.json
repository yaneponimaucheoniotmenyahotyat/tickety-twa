{
  "name": "tickety-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "public": "node --env-file-if-exists=.env src/public.js",
    "start": "node src/index.js",
    "stop": "node --env-file-if-exists=.env scripts/stop.js",
    "test-tickets": "node scripts/make-test-tickets.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "test": "node --test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@napi-rs/canvas": "1.0.9",
    "fastify": "5.12.5",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1"
  }
}
