# Скопируйте в server/.env и заполните. Файл .env в git не попадает.

# Токен бота из @BotFather. Им сервер проверяет подпись initData от Telegram.
BOT_TOKEN=

# PostgreSQL на хостинге. Пусто — локальная база PGlite в папке server/.data
DATABASE_URL=

PORT=8787

# Откуда разрешены запросы (CORS), через запятую
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://yaneponimaucheoniotmenyahotyat.github.io

# Сколько секунд initData считается свежей (по умолчанию сутки)
INIT_DATA_MAX_AGE=86400

# Только для локальной разработки в браузере: заголовок «Authorization: dev <id>»
# вместо подписи Telegram. На проде сервер с этим флагом не запустится.
ALLOW_DEV_AUTH=0

# Администраторы — Telegram id через запятую. Только они видят «Админку» в профиле:
# заводят события с прайсом зон и модерируют объявления.
ADMIN_IDS=
